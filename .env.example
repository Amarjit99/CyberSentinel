# CyberSentinel AI — Local Development Environment Configuration
# WARNING: NEVER commit production secrets or real API keys to version control.
# Copy this file to .env for local development: `cp .env.example .env`

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1

# Security & Secret Key (Local development placeholder only)
SECRET_KEY=local_insecure_development_secret_key_minimum_32_chars_long
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL Configuration (Local development credentials)
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=cybersentinel_dev
POSTGRES_PASSWORD=local_dev_password_change_in_production
POSTGRES_DB=cybersentinel_db
DATABASE_URL=postgresql://cybersentinel_dev:local_dev_password_change_in_production@127.0.0.1:5432/cybersentinel_db

# OpenSearch Configuration (Phase 2+ search & analytics)
OPENSEARCH_HOST=127.0.0.1
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=local_opensearch_dev_password

# Redis Configuration (Phase 2+ caching & task coordination)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# Response Actions Safety Invariant (MUST remain true in dev/staging/lab)
LIVE_RESPONSE_DISABLED=true
DRY_RUN_DEFAULT=true
